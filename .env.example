# Application Configuration
APP_NAME="IMEI Bot Platform"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=imei_bot
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/public/bot.php
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# WhatsApp Business API Configuration
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_WEBHOOK_URL=https://your-domain.com/public/whatsapp.php

# Security Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
ENCRYPTION_KEY=your_32_character_encryption_key_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SESSION_LIFETIME=120

# Cloud Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
CDN_URL=https://cdn.your-domain.com

# Payment Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@imei-bot.com
MAIL_FROM_NAME="IMEI Bot Platform"

# Monitoring & Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
SENTRY_LARAVEL_DSN=your_sentry_dsn

# Performance & Caching
CACHE_DRIVER=redis
CACHE_TTL=3600
QUEUE_CONNECTION=redis
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_MINUTES=1

# File Upload Configuration
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=zip,7z,rar,tar,gz,bin,img,cert,qcn,nvram
UPLOAD_PATH=storage/uploads
TEMP_PATH=storage/uploads/temp

# Bot Configuration
IMEI_PREFIXES=35,86,89,45
MAX_IMEI_PER_REQUEST=50
ENABLE_IMEI_VALIDATION=true
ENABLE_FILE_SCANNING=true
ENABLE_RATE_LIMITING=true

# Features
ENABLE_WHATSAPP=false
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true
ENABLE_API_DOCS=true
ENABLE_DARK_MODE=true
ENABLE_MULTI_LANGUAGE=true
